---
/** Custom line icons for each category (pillow, mattress, moon & stars). */
interface Props { name: string; size?: number; }
const { name, size = 40 } = Astro.props;
---
<svg class="cat-icon" width={size} height={size} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'pillows' && (
    <>
      <path d="M8 16c0-4 2-6 6-6h20c4 0 6 2 6 6v14c0 4-2 6-6 6H14c-4 0-6-2-6-6z" />
      <path d="M8 16c3 1 3 13 0 14M40 16c-3 1-3 13 0 14" />
      <path d="M16 20c5 2 11 2 16 0" opacity=".6" />
    </>
  )}
  {name === 'mattresses-toppers' && (
    <>
      <rect x="5" y="20" width="38" height="12" rx="3" />
      <path d="M7 20c0-3 2-5 5-5h24c3 0 5 2 5 5" />
      <path d="M8 32v5M40 32v5M12 26h4M22 26h4M32 26h4" />
    </>
  )}
  {name === 'sleep-guides' && (
    <>
      <path d="M30 8a14 14 0 1 0 11 22A12 12 0 0 1 30 8z" />
      <path d="M12 9v4M10 11h4M38 36v3M36.5 37.5h3" />
    </>
  )}
  {name === 'research' && (<><circle cx="21" cy="21" r="11" /><path d="M29 29l10 10M16 21h10M21 16v10" /></>)}
  {name === 'shield' && (<><path d="M24 6l14 5v11c0 10-6 17-14 20-8-3-14-10-14-20V11z" /><path d="M18 24l4 4 8-9" /></>)}
  {name === 'heart' && (<path d="M24 39S8 30 8 18a8 8 0 0 1 16-2 8 8 0 0 1 16 2c0 12-16 21-16 21z" />)}
  {name === 'refresh' && (<><path d="M38 20a14 14 0 0 0-26-5M10 28a14 14 0 0 0 26 5" /><path d="M12 8v7h7M36 40v-7h-7" /></>)}
</svg>
