---
import { SITE, NAV } from '../site.config.mjs';
import Logo from './Logo.astro';
const current = Astro.url.pathname;
const pillar = '/guides/how-to-choose-a-pillow-for-side-sleeping/';
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <Logo />
      <span class="brand-name">{SITE.name}</span>
    </a>
    <nav aria-label="Main" class="nav-desktop">
      <ul>
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn btn-glow btn-sm header-cta" href={pillar}>Pillow guide</a>
    <details class="nav-toggle">
      <summary aria-label="Open menu"><span class="burger" aria-hidden="true"></span><span class="sr-only">Menu</span></summary>
      <nav aria-label="Main mobile" class="nav-mobile">
        <ul>
          {NAV.map((item) => (
            <li><a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
          <li><a class="btn btn-glow" href={pillar}>Start with the pillow guide</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
