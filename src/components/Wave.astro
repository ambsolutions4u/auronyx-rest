---
/** Decorative wave divider. `fill` should match the colour of the NEXT section. */
interface Props { fill?: string; flip?: boolean; className?: string; }
const { fill = 'var(--bg)', flip = false, className = '' } = Astro.props;
---
<div class={`wave ${flip ? 'wave-flip' : ''} ${className}`} aria-hidden="true">
  <svg viewBox="0 0 1440 90" preserveAspectRatio="none"><path d="M0 50c160 30 320 40 480 22S800 8 960 14s320 46 480 40v36H0z" fill={fill} /></svg>
</div>
