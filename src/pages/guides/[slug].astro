---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisclosureBox from '../../components/DisclosureBox.astro';
import MedicalDisclaimer from '../../components/MedicalDisclaimer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NightSky from '../../components/NightSky.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import Wave from '../../components/Wave.astro';
import { SITE, CATEGORIES } from '../../site.config.mjs';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate, updatedDate, category, hasAffiliateLinks, readingTime } = entry.data;
const cat = CATEGORIES[category];
const updated = updatedDate ?? pubDate;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const url = new URL(`/guides/${entry.id}/`, SITE.url).href;

const related = (await getCollection('guides'))
  .filter((e) => e.id !== entry.id)
  .sort((a, b) => Number(b.data.category === category) - Number(a.data.category === category) || a.data.order - b.data.order)
  .slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: updated.toISOString(),
    author: { '@type': 'Organization', name: SITE.author, url: SITE.url },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', SITE.url).href },
    },
    image: new URL(SITE.ogImage, SITE.url).href,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    articleSection: cat.label,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: cat.label, item: new URL(cat.href, SITE.url).href },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  ogType="article"
  jsonLd={jsonLd}
  publishedTime={pubDate.toISOString()}
  modifiedTime={updated.toISOString()}
  progress
>
  <article class="article">
    <header class={`article-header band-${category}`}>
      <NightSky density={55} seed={entry.id.length} />
      <div class="container narrow article-header-inner">
        <span class="article-icon" aria-hidden="true"><CategoryIcon name={category} size={34} /></span>
        <nav aria-label="Breadcrumb" class="breadcrumb small">
          <a href="/">Home</a> <span aria-hidden="true">/</span> <a href={cat.href}>{cat.label}</a>
        </nav>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <p class="byline small">
          By <strong>{SITE.author}</strong> ·
          Published <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time> ·
          Updated <time datetime={updated.toISOString()}>{fmt(updated)}</time>
          {readingTime && <> · {readingTime}</>}
        </p>
      </div>
      <Wave fill="var(--bg)" />
    </header>
    <div class="container narrow">
      {hasAffiliateLinks && <DisclosureBox />}
      <div class="prose">
        <Content />
      </div>
      <MedicalDisclaimer />
    </div>
  </article>
  <section class="container section">
    <p class="eyebrow">Keep reading</p>
    <h2 class="section-title">Related guides</h2>
    <div class="grid cards-3">{related.map((e) => <ArticleCard entry={e} />)}</div>
  </section>
</BaseLayout>
